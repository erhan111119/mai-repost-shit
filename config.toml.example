# mai repost shit 示例配置
# 复制成 config.toml 后按需修改；也可以直接启动，宿主会用同样的默认值自动生成。

[plugin]
# 装好后默认关闭，确认群号填对了再打开
enabled = false
config_version = "1.0.0"

[target]
# 目标群号列表（填群号，不是 session_id）
groups = []
# 每天搬几次
daily_times = 3
# 允许发送的时间范围 [起, 止]，24 小时制
active_hours = [9, 23]
# 错过计划时刻后多久内仍补发（分钟），超时直接跳过，避免重启后补发一堆
catch_up_minutes = 30
# 聊天记录里视频上方是否带标题与数据说明
include_header_text = true

[source]
# 关键词池：屎不挑分区，靠这组词捞候选，再由艾特率筛
keywords = ["鬼畜", "抽象", "整活", "绷不住", "答辩", "逆天", "难绷", "离谱", "沙雕", "搞笑", "名场面", "迷惑行为", "吐槽", "社死", "破防", "神操作"]
keywords_per_run = 6
orders = ["totalrank", "pubdate"]
page_max = 3
# 发布时间窗 [最近, 最远]（小时）
window_hours = [72, 720]
play_min = 50000
play_max = 300000
# 评论数下限：搜索接口自带该字段，先卡掉分母不足的视频
min_video_review = 40
# 每轮最多实际检查几条候选（每条约 4 个请求；实测约 20% 能过 50% 艾特率）
max_check_per_run = 12

[judge]
# 评论含 @ 比例阈值
at_ratio_threshold = 0.5
# 评论样本下限，不足一律判样本不足
min_comments = 30
comment_pages = 3

[download]
max_duration_seconds = 240
max_size_mb = 40
# 64=720P, 32=480P, 16=360P；免登录最高只给到 720P
quality_preference = [64, 32, 16]
keep_files = 2

[filters]
title_blacklist = ["原神", "崩坏", "星穹铁道", "剧透", "直播回放", "录播", "合集"]
tag_blacklist = []
up_blacklist = []

[tool]
# 是否允许群友用自然语言叫它搬史（LLM 工具 repost_shi）
enabled = true
# 同一个群两次点播的最小间隔（分钟）
cooldown_minutes = 10
# 每个群每天点播的次数上限（0 表示不限）
daily_limit_per_group = 3
# 单次点播最多搬几条
max_count = 3
