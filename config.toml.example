# ============================================================================
# B站搬史机（mai repost shit）示例配置
# 复制成 config.toml 后按需修改；也可以直接启动，宿主会用同样的默认值自动生成。
# 判据只有一条：评论区艾特率。
# ============================================================================

[plugin]
# 插件总开关：装好后默认关闭，确认群号填对了再打开
enabled = false
# 配置版本（插件自己维护，一般不用动）
config_version = "1.0.4"

[target]
# 目标群号列表（填群号，不是 session_id；空串会被忽略）
groups = []
# 每天搬几次（时刻在下面的时间段内随机分布）
daily_times = 3
# 允许发送的时间范围 [起, 止]，24 小时制
active_hours = [9, 23]
# 错过计划时刻后多久内仍补发（分钟）；超时直接跳过，避免重启后一次补发好几条
catch_up_minutes = 30
# 聊天记录里视频上方是否带说明（标题 / UP / 播放 / 艾特率 / 链接）
include_header_text = true
# 投递路线：forward = 聊天记录内嵌视频（默认）、video = 直接发视频、file = 按文件发。
# 三条路会自动依次回退；哪天视频发不出来，先改这里换一条路试试。
delivery_mode = "forward"
# 三条路都失败时是否往群里说一句（避免安静地什么都不发，只留日志）
notify_on_failure = true

[source]
# 关键词池：每轮随机抽几个去搜。屎不挑分区，靠词覆盖 + 艾特率筛。
# 实测：偏主流搞笑的词（沙雕/搞笑/名场面）几乎捞不到合格候选，
# 泛鬼畜词（鬼畜/绷不住/答辩/难绷）命中率明显更高，所以默认混着用。
keywords = ["鬼畜", "抽象", "整活", "绷不住", "答辩", "逆天", "难绷", "离谱", "沙雕", "搞笑", "名场面", "迷惑行为", "吐槽", "社死", "破防", "神操作"]
# 每轮用几个关键词去搜（越多候选越多，请求也越多）
keywords_per_run = 6
# 搜索排序，每轮随机选一个：totalrank = 综合排序、pubdate = 按发布时间。
# 不要用 click：它只给爆款，在 5万~30万 这个播放区间命中率实测为 0。
orders = ["totalrank", "pubdate"]
# 每个关键词随机翻到第几页（上限）
page_max = 3
# 发布时间窗 [最近, 最远]（小时）：默认 3 天前 ~ 30 天前发布
window_hours = [72, 720]
# 播放量区间（太低没评论、太高没屎味）
play_min = 50000
play_max = 300000
# 评论数下限：搜索接口自带该字段，先卡掉分母不够的视频（艾特率要有足够样本才算数）
min_video_review = 40
# 每轮最多实际检查几条候选（每条约 4 个请求；实测约 20% 能过 50% 艾特率）
max_check_per_run = 12

[judge]
# 唯一判据：采到的评论里含 @ 的比例达到这个值才算"史"
at_ratio_threshold = 0.5
# 评论样本下限：不足这个数一律判"样本不足"（分母太小，比值是噪声）
min_comments = 30
# 每个候选取几页评论（每页 20 条）；实测取 3 页与取 6 页的通过数相同
comment_pages = 3

[download]
# 时长上限（秒）：超过就跳过，避免搬来几十分钟的合集
max_duration_seconds = 240
# 体积上限（MB）：下载过程中超了就放弃
max_size_mb = 40
# 清晰度优先级：64=720P, 32=480P, 16=360P。
# 免登录最高只给到 720P，所以"压到 720p"就是选档下载，不需要 ffmpeg 转码。
quality_preference = [64, 32, 16]
# 本地保留最近几个视频文件（其余在发送成功后清理）
keep_files = 2

[filters]
# 标题屏蔽词（子串匹配，命中即跳过）。默认挡的是长剧集 / 直播切片 / 剧透这类
# 容易混进来的内容；不想要就把列表清空。
title_blacklist = ["原神", "崩坏", "星穹铁道", "剧透", "直播回放", "录播", "合集"]
# 标签屏蔽词（搜索接口返回的 tag 字段，子串匹配）
tag_blacklist = []
# UP 主屏蔽词（子串匹配）
up_blacklist = []

[tool]
# 是否允许群友用自然语言叫它搬史（LLM 工具 repost_shi）
enabled = true
# 谁能触发：anyone = 群里任何人都可以（默认）、whitelist = 只有 whitelist 里的 QQ 能触发。
# 注意：工具回调拿不到点播者的 QQ，白名单是靠入站钩子按会话回查"最近发言者"实现的，
# 同一群多人抢话时可能错位，所以白名单模式下认不出发言者会直接拒绝。
permission = "anyone"
# permission = "whitelist" 时允许触发的 QQ 号列表
whitelist = []
# 发言者缓存有效期（秒）：超时后白名单模式会拒绝，需要对方重新发言
speaker_cache_ttl_seconds = 600
# 同一个群两次点播的最小间隔（分钟）
cooldown_minutes = 10
# 每个群每天点播的次数上限（0 表示不限）
daily_limit_per_group = 3
# 单次点播最多搬几条
max_count = 3
